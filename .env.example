# Public app config
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Server-only Supabase access
SUPABASE_SERVICE_ROLE_KEY=

# PayPal monthly subscriptions (use PAYPAL_ENV=live only with live credentials)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PRO_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# payOS / VietQR one-time 30-day access
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Usage cost estimates used only for operational metering
NUMINA_ESTIMATED_TEXT_COST_USD=0
NUMINA_ESTIMATED_IMAGE_COST_USD=0
NUMINA_REQUIRE_DURABLE_LIMITS=true
# Set true only when the hosting proxy overwrites x-forwarded-for/x-real-ip.
NUMINA_TRUST_PROXY_HEADERS=false

# LLM cascade. Header, first-content, and stream-idle deadlines are independent.
LLM_PROVIDER_ORDER=Groq,Google Gemini,NVIDIA NIM
GROQ_API_KEY=
GROQ_CHAT_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_CHAT_MODELS=gemini-3.6-flash
GEMINI_REASONING_EFFORT=minimal
NVIDIA_API_KEY=
NVIDIA_CHAT_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,meta/muse-glimmer-30b,poolside/laguna-xs-2.1
NVIDIA_ENABLE_THINKING=false
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODELS=openrouter/free
LLM_RESPONSE_HEADER_TIMEOUT_MS=2000
LLM_FIRST_CONTENT_TIMEOUT_MS=5000
LLM_STREAM_IDLE_TIMEOUT_MS=30000
