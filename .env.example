# Public app config
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_PRO_PRICE_LABEL=99,000 VND

# Server-only Supabase access
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout + webhook
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Usage cost estimates used only for operational metering
NUMINA_ESTIMATED_TEXT_COST_USD=0
NUMINA_ESTIMATED_IMAGE_COST_USD=0
NUMINA_REQUIRE_DURABLE_LIMITS=true
# Set true only when the hosting proxy overwrites x-forwarded-for/x-real-ip.
NUMINA_TRUST_PROXY_HEADERS=false

# Switch to the next LLM provider when the stream connection takes too long.
# 1000ms keeps fallback responsive; increase for providers with slower warm-up.
LLM_STREAM_CONNECT_TIMEOUT_MS=1000
